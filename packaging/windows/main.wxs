<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!--
    Built by .github/workflows/build.yml:
      wix build -arch x64 -d Version=<x.y.z> -d SourceDir=<repo> main.wxs -o out.msi
  -->
  <Package
    Name="Inkdown"
    Manufacturer="ice-a"
    Version="$(var.Version)"
    UpgradeCode="7C3E9A52-6B4D-4C8F-9A21-58D7F0B2E6A1"
    Scope="perUser">
    <!-- Force true per-user semantics: files under %LOCALAPPDATA% and the
         Add/Remove entry under HKCU, with no elevation prompt. -->
    <Property Id="ALLUSERS" Value="2" />
    <Property Id="MSIINSTALLPERUSER" Value="1" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Inkdown is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Per-user install: %LOCALAPPDATA%\Programs\Inkdown. A standard
         (non-admin) Windows account can install without any UAC prompt. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
      <Directory Id="INSTALLFOLDER" Name="Inkdown">
        <Component Id="InkdownExe" Guid="AA28E20C-039F-4C1D-BC0C-3CCDC0FBDFED">
          <File Id="InkdownExeFile" Source="$(var.SourceDir)/inkdown.exe" KeyPath="yes">
            <Shortcut
              Id="StartMenuShortcut"
              Directory="ProgramMenuDir"
              Name="Inkdown"
              WorkingDirectory="INSTALLFOLDER"
              Advertise="yes" />
          </File>
        </Component>
      </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuDir" Name="Inkdown" />
    </StandardDirectory>

    <Feature Id="Main" Title="Inkdown">
      <ComponentRef Id="InkdownExe" />
    </Feature>
  </Package>
</Wix>
